  "VeedCleanAudioNode": {
    "input": {
      "required": {
        "audio": [
          "AUDIO",
          {
            "tooltip": "Speech recording, shorter than 30 minutes."
          }
        ],
        "strength": [
          "FLOAT",
          {
            "tooltip": "How much noise is removed under speech. Lower keeps more room tone behind the voice; pauses between words are always fully cleaned, and values above the default change little.",
            "default": 0.874,
            "min": 0,
            "max": 1,
            "step": 0.001
          }
        ],
        "loudness": [
          "COMFY_DYNAMICCOMBO_V3",
          {
            "options": [
              {
                "key": "normalize",
                "inputs": {
                  "required": {
                    "target_lufs": [
                      "FLOAT",
                      {
                        "tooltip": "Integrated loudness of the output in LUFS. Peaks are capped at -1.1 dBTP, so loud targets stop early (about -15 LUFS for typical speech).",
                        "default": -19,
                        "min": -40,
                        "max": -8,
                        "step": 0.1
                      }
                    ]
                  }
